{
  "schema_version": 1,
  "id": "G-034",
  "name": "third-party-open-never-renders",
  "why": "Fact selection has one narrow contract: render only facts with resolvable provenance, require named inputs for inferences, and never admit third-party-open text. This mixed case keeps the valid path and all three rejection paths together.",
  "covers": [
    "B-007",
    "B-008",
    "B-022"
  ],
  "case_type": "negative_control",
  "traces_to": [
    "AUD-07-7",
    "AUD-LINE-3",
    "AUD-LINE-5",
    "DEC-4"
  ],
  "defends_against": "An implementation that drops every fact, renders facts without sources, lets an untraceable inference inherit a source, or treats a tagged post as a fact about the member.",
  "time_sensitive": false,
  "given": {
    "inputs": {
      "candidate_facts": [
        {
          "fact_id": "f_blog",
          "text": "Has written about crypto protocols since 2013.",
          "trust_class": "subject_authored",
          "provenance_class": "self_published",
          "source_url": "https://avc.com/",
          "source_date": "2026-07-23"
        },
        {
          "fact_id": "f_unsourced",
          "text": "Prefers the corner table.",
          "trust_class": "subject_authored",
          "provenance_class": "self_published",
          "source_url": null,
          "source_date": "2026-07-23"
        },
        {
          "fact_id": "f_inferred_untraceable",
          "text": "Is probably in town to raise.",
          "trust_class": "subject_authored",
          "provenance_class": "inferred",
          "source_url": "internal://composition",
          "source_date": "2026-09-03",
          "composed_from": []
        },
        {
          "fact_id": "f_tagged",
          "text": "Contributed a sculpture to a World Cup public art installation.",
          "trust_class": "third_party_open",
          "provenance_class": "third_party",
          "source_url": "https://www.instagram.com/p/DalKAw4kcSl/",
          "source_date": "2026-06-01"
        }
      ]
    },
    "preexisting_state": {},
    "configuration": {
      "render_trust_classes": [
        "subject_authored",
        "publisher"
      ]
    },
    "clock": {}
  },
  "when": {
    "operation": "select_renderable_facts",
    "input_refs": [
      "f_blog",
      "f_unsourced",
      "f_inferred_untraceable",
      "f_tagged"
    ]
  },
  "expect": {
    "exact": {
      "result": {
        "renderable_fact_ids": [
          "f_blog"
        ],
        "rejected": [
          {
            "fact_id": "f_inferred_untraceable",
            "reason": "inferred_without_named_inputs"
          },
          {
            "fact_id": "f_tagged",
            "reason": "third_party_open"
          },
          {
            "fact_id": "f_unsourced",
            "reason": "missing_provenance"
          }
        ],
        "provenance_chips": [
          {
            "fact_id": "f_blog",
            "source_host": "avc.com",
            "provenance_class": "self_published"
          }
        ],
        "narrator_context_fact_ids": [
          "f_blog"
        ],
        "third_party_open_in_narrator_context": 0
      },
      "state_changes": [],
      "emitted_events": [],
      "external_calls": []
    },
    "properties": []
  }
}

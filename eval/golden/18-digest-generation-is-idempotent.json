{
  "schema_version": 1,
  "id": "G-018",
  "name": "digest-generation-is-idempotent",
  "why": "The demo re-runs an arrival on stage. The same name against the same roster and the same cache must produce the same card, or the engine is not showing a decision, it is showing a sample.",
  "covers": [
    "B-014",
    "B-011"
  ],
  "case_type": "idempotency",
  "traces_to": [
    "DEC-3",
    "DEC-5"
  ],
  "defends_against": "An implementation whose card varies between runs because the narrator is sampled at a non-zero temperature or the roster is iterated non-deterministically.",
  "time_sensitive": true,
  "given": {
    "inputs": {
      "arrival": {
        "member_id": "m_feld",
        "roster_id": "r_friday_1900"
      },
      "invocations": 2
    },
    "preexisting_state": {
      "profile_cache_version": "pc_2026_09_03_a",
      "roster_snapshot": "r_friday_1900"
    },
    "configuration": {
      "word_band": [
        250,
        350
      ],
      "required_blocks": [
        "Who",
        "Now",
        "Room",
        "Notice",
        "Say"
      ],
      "surface_min_score": 6,
      "surface_requires_any_of": [
        "S3",
        "S5",
        "S7"
      ],
      "narrator_temperature": 0,
      "cache_mode": "read_only"
    },
    "clock": {
      "as_of": "2026-09-03T19:00:00Z"
    }
  },
  "when": {
    "operation": "generate_digest_repeated",
    "input_refs": [
      "m_feld"
    ]
  },
  "expect": {
    "exact": {
      "result": {
        "invocation_count": 2,
        "digest_hashes_identical": true,
        "distinct_digest_count": 1,
        "cache_writes": 0
      },
      "state_changes": [],
      "emitted_events": [],
      "external_calls": []
    },
    "properties": []
  }
}
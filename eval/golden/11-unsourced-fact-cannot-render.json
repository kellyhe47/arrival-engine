{
  "schema_version": 1,
  "id": "G-011",
  "name": "unsourced-fact-cannot-render",
  "why": "Provenance is the mechanism that makes the widest sourcing policy defensible. A fact that cannot name where it came from is exactly the fact a member would object to hearing.",
  "covers": [
    "B-007"
  ],
  "case_type": "negative_control",
  "traces_to": [
    "DEC-4",
    "AUD-LINE-3"
  ],
  "defends_against": "An implementation that treats provenance as display metadata, so a fact with a missing source silently renders without its chip.",
  "time_sensitive": false,
  "given": {
    "inputs": {
      "candidate_facts": [
        {
          "fact_id": "f_1",
          "text": "Runs Random Day, twenty minutes with any stranger.",
          "provenance_class": "self_published",
          "source_url": "https://feld.com/archives/2013/11/random-day.html",
          "source_date": "2013-11-01"
        },
        {
          "fact_id": "f_2",
          "text": "Prefers the corner table.",
          "provenance_class": "third_party",
          "source_url": null,
          "source_date": null
        }
      ]
    },
    "preexisting_state": {},
    "configuration": {
      "word_band": [
        250,
        350
      ],
      "required_blocks": [
        "Who",
        "Now",
        "Room",
        "Notice",
        "Say"
      ],
      "surface_min_score": 6,
      "surface_requires_any_of": [
        "S3",
        "S5",
        "S7"
      ]
    },
    "clock": {}
  },
  "when": {
    "operation": "select_renderable_facts",
    "input_refs": [
      "f_1",
      "f_2"
    ]
  },
  "expect": {
    "exact": {
      "result": {
        "renderable_fact_ids": [
          "f_1"
        ],
        "rejected": [
          {
            "fact_id": "f_2",
            "reason": "missing_provenance"
          }
        ]
      },
      "state_changes": [],
      "emitted_events": [],
      "external_calls": []
    },
    "properties": []
  }
}
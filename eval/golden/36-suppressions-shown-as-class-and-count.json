{
  "schema_version": 1,
  "id": "G-036",
  "name": "suppressions-shown-as-class-and-count",
  "why": "This is the visible answer to 'what did you choose to leave out'. Huffman's Form 4 share sales are public, filed and verified \u2014 and suppressed. The counter proves restraint without leaking the thing it withheld.",
  "covers": [
    "B-024"
  ],
  "case_type": "happy",
  "traces_to": [
    "RUBRIC-3",
    "DEC-4"
  ],
  "defends_against": "An implementation that either hides suppressions entirely (so restraint is invisible and unprovable) or names them (so the counter leaks exactly what it withheld).",
  "time_sensitive": false,
  "given": {
    "inputs": {
      "suppressed_facts": [
        {
          "fact_id": "f_form4",
          "class": "finance_personal",
          "text": "Sold 45,000 shares on 2026-05-14."
        },
        {
          "fact_id": "f_family",
          "class": "family_private",
          "text": "REDACTED"
        }
      ],
      "rendered_fact_ids": [
        "f_blog",
        "f_hn"
      ]
    },
    "preexisting_state": {},
    "configuration": {
      "suppression_display": "class_and_count"
    },
    "clock": {}
  },
  "when": {
    "operation": "build_suppression_notice",
    "input_refs": [
      "m_huffman"
    ]
  },
  "expect": {
    "exact": {
      "result": {
        "withheld_count": 2,
        "withheld_classes": [
          "family_private",
          "finance_personal"
        ],
        "notice_text": "2 withheld: family, finance",
        "withheld_text_exposed": 0
      },
      "state_changes": [],
      "emitted_events": [],
      "external_calls": []
    },
    "properties": []
  }
}
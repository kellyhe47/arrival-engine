{
  "schema_version": 1,
  "id": "G-028",
  "name": "session-adapters-expose-no-write-ops",
  "why": "The account being driven belongs to the operator, and a stray write is not recoverable \u2014 a like or a follow is visible to the other person immediately. Read-only must be a property of the interface, not a rule someone remembers.",
  "covers": [
    "B-018"
  ],
  "case_type": "negative_control",
  "traces_to": [
    "DEC-6"
  ],
  "defends_against": "An implementation that enforces read-only with a runtime check or a prompt instruction, which a retry, a refactor, or an injected page instruction can defeat.",
  "time_sensitive": false,
  "given": {
    "inputs": {
      "adapter_interface": {
        "source_id": "linkedin_profile",
        "tier": "SESSION",
        "declared_operations": [
          "fetch_profile",
          "fetch_activity"
        ]
      },
      "attempted_operation": "post_comment"
    },
    "preexisting_state": {},
    "configuration": {
      "allowed_operation_prefixes": [
        "fetch_",
        "read_",
        "list_"
      ]
    },
    "clock": {}
  },
  "when": {
    "operation": "resolve_adapter_operation",
    "input_refs": [
      "linkedin_profile"
    ]
  },
  "expect": {
    "exact": {
      "result": {
        "resolved": false,
        "reason": "operation_not_declared_by_adapter",
        "declared_operations": [
          "fetch_activity",
          "fetch_profile"
        ],
        "write_operations_available": 0
      },
      "state_changes": [],
      "emitted_events": [],
      "external_calls": []
    },
    "properties": []
  }
}
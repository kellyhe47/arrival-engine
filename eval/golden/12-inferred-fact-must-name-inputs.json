{
  "schema_version": 1,
  "id": "G-012",
  "name": "inferred-fact-must-name-inputs",
  "why": "Composition is where personalization turns into surveillance. Two innocuous facts joined into a third are the Uber and Target failure exactly, so an inferred fact must carry the facts it was built from or it cannot render.",
  "covers": [
    "B-008"
  ],
  "case_type": "negative_control",
  "traces_to": [
    "AUD-LINE-5",
    "DEC-4"
  ],
  "defends_against": "An implementation that assigns provenance only to leaf facts, letting a composed inference inherit a source it did not actually come from.",
  "time_sensitive": false,
  "given": {
    "inputs": {
      "candidate_facts": [
        {
          "fact_id": "f_3",
          "text": "Has written about long-term governance every year since 2019.",
          "provenance_class": "inferred",
          "source_url": "internal://composition",
          "source_date": "2026-09-03",
          "composed_from": [
            "f_a",
            "f_b",
            "f_c"
          ]
        },
        {
          "fact_id": "f_4",
          "text": "Is probably in town to raise.",
          "provenance_class": "inferred",
          "source_url": "internal://composition",
          "source_date": "2026-09-03",
          "composed_from": []
        }
      ]
    },
    "preexisting_state": {},
    "configuration": {
      "word_band": [
        250,
        350
      ],
      "required_blocks": [
        "Who",
        "Now",
        "Room",
        "Notice",
        "Say"
      ],
      "surface_min_score": 6,
      "surface_requires_any_of": [
        "S3",
        "S5",
        "S7"
      ]
    },
    "clock": {}
  },
  "when": {
    "operation": "select_renderable_facts",
    "input_refs": [
      "f_3",
      "f_4"
    ]
  },
  "expect": {
    "exact": {
      "result": {
        "renderable_fact_ids": [
          "f_3"
        ],
        "rejected": [
          {
            "fact_id": "f_4",
            "reason": "inferred_without_named_inputs"
          }
        ]
      },
      "state_changes": [],
      "emitted_events": [],
      "external_calls": []
    },
    "properties": []
  }
}